#tag EndWebContainerControl

#tag WindowCode
	#tag Event
		Sub Shown()
		  If Self.SelectedStationUids.Count = 0 Then
		    For Each station As StationModel In App.DataSvc.Stations
		      Self.SelectedStationUids.Add(station.Uid)
		    Next
		  End
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h21
		Private Sub StationListOkPressed(sender as Object, selectedStationUids() as String)
		  Self.SelectedStationUids = selectedStationUids
		  
		  Var stationNames() As String
		  For Each stationUid As String In Self.SelectedStationUids
		    stationNames.Add(App.DataSvc.GetCachedStationByUid(stationUid).ShortName)
		  Next
		  
		  btnExport.Enabled = stationNames.Count > 0
		  
		  If selectedStationUids.Count = App.DataSvc.Stations.Count Then
		    btnStations.Caption = "Alle Stationen"
		  ElseIf selectedStationUids.Count = 0 Then
		    btnStations.Caption = "Keine Station"
		  else
		    btnStations.Caption = if(stationNames.Count = 1, "Eine Station", str(stationNames.Count) + " Stationen") +  " (" + string.FromArray(stationNames, ", ") + ")"
		  end
		End Sub
	#tag EndMethod


	#tag Hook, Flags = &h0
		Event ExportPressed(dtFrom as DateTime, dtTo as DateTime, types() as string, stations() as String)
	#tag EndHook


	#tag ComputedProperty, Flags = &h21
		#tag Getter
			Get
			  return dtFrom.SelectedDate
			End Get
		#tag EndGetter
		Private DateFrom As DateTime
	#tag EndComputedProperty

	#tag ComputedProperty, Flags = &h21
		#tag Getter
			Get
			  return dtTo.SelectedDate
			End Get
		#tag EndGetter
		Private DateTo As DateTime
	#tag EndComputedProperty

	#tag Property, Flags = &h21
		Private SelectedComponentTypes() As String
	#tag EndProperty

	#tag Property, Flags = &h21
		Private SelectedStationUids() As String
	#tag EndProperty


#tag EndWindowCode

#tag Events dtFrom
	#tag Event
		Sub Opening()
		  me.MaximumDate = DateTime.Now
		  me.SelectedDate = DateTime.Now.SubtractInterval(0, 1, 0)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events dtTo
	#tag Event
		Sub Opening()
		  Me.MaximumDate = DateTime.Now
		  me.SelectedDate = DateTime.Now
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events sgComponents
	#tag Event
		Sub Pressed(segmentIndex As Integer)
		  sgFaults.SegmentAt(0).Selected = False
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events sgFaults
	#tag Event
		Sub Pressed(segmentIndex As Integer)
		  For i As Integer = 0 To sgComponents.SegmentCount - 1
		    sgComponents.SegmentAt(i).Selected = false
		  Next
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnExport
	#tag Event
		Sub Pressed()
		  SelectedComponentTypes.RemoveAll
		  
		  If sgFaults.SegmentAt(0).Selected Then
		    SelectedComponentTypes.Add("FL")
		  else
		    If sgComponents.SegmentAt(0).Selected Then 
		      SelectedComponentTypes.Add("AC") 
		      SelectedComponentTypes.Add("SW")
		    end
		    If sgComponents.SegmentAt(1).Selected Then SelectedComponentTypes.Add("CO")
		    If sgComponents.SegmentAt(2).Selected Then SelectedComponentTypes.Add("FI")
		    If sgComponents.SegmentAt(3).Selected Then SelectedComponentTypes.Add("SE")
		  end
		  
		  RaiseEvent ExportPressed(DateFrom, DateTo, SelectedComponentTypes, SelectedStationUids)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events btnStations
	#tag Event
		Sub Pressed()
		  
		  
		  Var popup As New SelectableStationListContainer(Self.SelectedStationUids)
		  AddHandler popup.OkPressed, AddressOf StationListOkPressed
		  popup.ShowPopover(me)
		End Sub
	#tag EndEvent
#tag EndEvents

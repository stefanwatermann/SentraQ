#tag Events lbFqdn
	#tag Event
		Sub Shown()
		  Me.Text = Session.FQDN
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbUserAgent
	#tag Event
		Sub Shown()
		  Me.Text = Session.UserAgent
		  me.Tooltip = session.UserAgent
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbClientWidth
	#tag Event
		Sub Shown()
		  Me.Text = str(Session.ClientWidth)
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbClientHeight
	#tag Event
		Sub Shown()
		  Me.Text = str(Session.ClientHeight)
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbClientTime
	#tag Event
		Sub Shown()
		  Me.Text = Session.ClientTime.SQLDateTime
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbDarkmode
	#tag Event
		Sub Shown()
		  Me.Text = str(Session.IsDarkMode)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbAuth
	#tag Event
		Sub Shown()
		  Var currentUser As String = "not authenticated"
		  If Session.Authenticator.IsAuthenticatedUser Then
		    currentUser = Session.Authenticator.CurrentUserName
		  End 
		  Me.Text = currentUser
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbRemoteIp
	#tag Event
		Sub Shown()
		  Me.Text = Session.RemoteAddress
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbDomain
	#tag Event
		Sub Shown()
		  Me.Text = Session.Domain
		  
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbHttps
	#tag Event
		Sub Shown()
		  Me.Text = str(Session.Secure)
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbAppVersion
	#tag Event
		Sub Shown()
		  Me.Text = App.AppVersion + " (" + App.Version + ")"
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbBrowserLocale
	#tag Event
		Sub Shown()
		  Me.Text = "Client: " + Session.LanguageCode + " - Session: " + Session.Locale.Identifier + " - Host: " + Locale.Current.Identifier
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbWasPasskey
	#tag Event
		Sub Shown()
		  Me.Text = Session.WasPasskeyAuthentication.ToString
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbServerTime
	#tag Event
		Sub Shown()
		  Me.Text = DateTime.Now.SQLDateTime
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events lbPlatform
	#tag Event
		Sub Shown()
		  Me.Text = Session.Platform
		  
		End Sub
	#tag EndEvent
#tag EndEvents
